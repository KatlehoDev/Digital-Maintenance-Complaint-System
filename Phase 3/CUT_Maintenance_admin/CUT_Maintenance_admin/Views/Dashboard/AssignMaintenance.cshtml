@model IEnumerable<CUT_Maintenance_Admin.Models.Complaint>
@{
    ViewData["Title"] = "Assign Maintenance";
    var workers = ViewBag.Workers as List<CUT_Maintenance_Admin.Models.Profile>;
}

<h4 class="fw-bold mb-1">Assign Maintenance</h4>
<p class="text-muted mb-4">Select a maintenance staff member to handle a complaint.</p>

<div class="row">
    <div class="col-md-7">
        @if (Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="card mb-4 shadow-sm border-0 bg-light">
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-3">
                            <span class="badge bg-info text-dark px-3 py-2 rounded-pill">Open</span>
                            <span class="text-muted fw-bold">Complaints ID: @item.Reference</span>
                        </div>
                        <h5 class="fw-bold mb-3 text-uppercase">@item.Title</h5>

                        <div class="d-flex mb-3 text-muted small">
                            <div class="me-4"><i class="fa-solid fa-location-dot me-1"></i> Location: @item.Residence?.Name, @item.Location</div>
                        </div>

                        <div class="bg-white p-3 rounded border mb-3">
                            <strong class="d-block mb-1"><i class="fa-solid fa-file-lines me-1"></i> Description</strong>
                            <span class="text-muted small">@item.Description</span>
                        </div>

                        <hr />
                        <h6 class="fw-bold mb-3">Select Staff Member</h6>

                        <form asp-controller="Dashboard" asp-action="Assign" method="post">
                            <input type="hidden" name="id" value="@item.Id" />

                            <div class="mb-3">
                                <select name="workerId" class="form-select bg-light" required>
                                    <option value="">Choose a maintenance staff member</option>
                                    @if (workers != null && workers.Any())
                                    {
                                        @foreach (var w in workers)
                                        {
                                            var displayName = string.IsNullOrEmpty(w.FullName) ? w.Email : w.FullName;
                                            <option value="@w.Id">@displayName (Available)</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold small text-muted">Set Deadline</label>
                                <input type="date" name="deadline" class="form-control bg-light" required value="@DateTime.UtcNow.AddDays(3).ToString("yyyy-MM-dd")" />
                            </div>

                            <div class="d-flex justify-content-end">
                                <button type="submit" class="btn btn-primary px-4" style="background-color: #0084D6;">Assign</button>
                            </div>
                        </form>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="alert alert-success border-0 shadow-sm">
                <i class="fa-solid fa-check-circle me-2"></i> No open complaints need assignment right now.
            </div>
        }
    </div>
</div>