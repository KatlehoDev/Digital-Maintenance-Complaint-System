@model CUT_Maintenance_Admin.Models.Category
@{
    ViewData["Title"] = "Edit Category";
}

<h4 class="fw-bold mb-1">Edit Category</h4>
<p class="text-muted mb-4">Modify the details of the maintenance category.</p>

<div class="row">
    <div class="col-md-6">
        <div class="p-4 bg-light rounded border">
            <form asp-action="EditCategory" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label class="form-label fw-bold small">Category Name*</label>
                    <input asp-for="Name" class="form-control bg-white" required />
                </div>
                <div class="mb-4">
                    <label class="form-label fw-bold small">Description*</label>
                    <textarea asp-for="Description" class="form-control bg-white" rows="4" required></textarea>
                </div>
                <div class="d-flex justify-content-between">
                    <a asp-action="ManageCategories" class="btn btn-outline-secondary px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4" style="background-color: #0084D6;">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>