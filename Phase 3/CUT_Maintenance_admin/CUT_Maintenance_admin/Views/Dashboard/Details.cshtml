@model CUT_Maintenance_Admin.Models.Complaint
@using CUT_Maintenance_Admin.Data
@{
    ViewData["Title"] = "Complaint Details";
    var history = ViewBag.History as List<CUT_Maintenance_Admin.Models.ComplaintHistory>;
    var assignedWorker = ViewBag.AssignedWorker as CUT_Maintenance_Admin.Models.Profile;
    var workers = ViewBag.Workers as List<CUT_Maintenance_Admin.Models.Profile>;

    var isOverdue = Model.Deadline < DateTime.UtcNow && Model.Status != ComplaintStatus.closed && Model.Status != ComplaintStatus.verified && Model.Status != ComplaintStatus.withdrawn && Model.Status != ComplaintStatus.rejected;
    var isReopened = Model.Status == ComplaintStatus.reopened;
    var isWithdrawn = Model.Status == ComplaintStatus.withdrawn;
    var isRejected = Model.Status == ComplaintStatus.rejected;

    // SHOW REASSIGN FORM FOR ANY ACTIVE JOB OR IF REJECTED/REOPENED
    var canReassign = Model.Status == ComplaintStatus.assigned ||
                      Model.Status == ComplaintStatus.accepted ||
                      Model.Status == ComplaintStatus.in_progress ||
                      isRejected ||
                      isReopened;

    // ONLY show reporter photos to the Admin
    var adminVisibleImages = Model.Images?.Where(i => i.Stage == "reporter").ToList() ?? new List<CUT_Maintenance_Admin.Models.ComplaintImage>();

    var supervisorEmail = "vincentthabang444@gmail.com";
    var emailSubject = Uri.EscapeDataString($"URGENT: Overdue Maintenance Complaint - {Model.Reference}");
    var emailBody = Uri.EscapeDataString($"Hi Supervisor,\n\nPlease note that the following maintenance complaint was not attended to within the specified deadline:\n\nReference: {Model.Reference}\nTitle: {Model.Title}\nLocation: {Model.Residence?.Name}, Room {Model.Location}\nStatus: {Model.Status.ToString()}\nDeadline: {Model.Deadline?.ToString("yyyy-MM-dd HH:mm")}\n\nPlease investigate and take necessary action.\n\nRegards,\nCUT Estate & Infrastructure");
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <div>
        <h4 class="fw-bold mb-1">Complaint Details</h4>
        <p class="text-muted mb-0">Reference: @Model.Reference</p>
    </div>
    <a asp-action="AllComplaints" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-arrow-left"></i> Back to All Complaints</a>
</div>

@if (isWithdrawn)
{
    <div class="alert alert-secondary shadow-sm border-0 mb-4">
        <h5 class="alert-heading fw-bold mb-1"><i class="fa-solid fa-ban me-2"></i>Complaint Withdrawn</h5>
        <p class="mb-0">This complaint has been withdrawn and no further action is required.</p>
    </div>
}

@if (canReassign)
{
    <div class="alert alert-danger shadow-sm border-0 mb-4 bg-white">
        <h5 class="alert-heading fw-bold text-danger mb-3">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>
            @(isRejected ? "Complaint Rejected by Worker!" : isReopened ? "Complaint Reopened by HCM!" : "Reassign Job / Change Worker")
        </h5>
        <p class="mb-4">
            @(isRejected
                ? "The maintenance worker rejected this job. You must reassign it to someone else."
                : isReopened
                    ? "The House Committee Member indicated that the previous work did not resolve the issue. You must reassign this complaint."
                    : "If the current worker is unavailable (e.g., sick or lost access), you can reassign this job to a new worker here.")
        </p>

        <form asp-action="Reassign" method="post" class="row g-3 align-items-end">
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="col-md-4">
                <label class="form-label fw-bold small text-muted">Assign Worker</label>
                <select name="workerId" class="form-select" required>
                    <option value="">Select a worker...</option>
                    @if (workers != null)
                    {
                        @foreach (var w in workers)
                        {
                            <option value="@w.Id">@(string.IsNullOrEmpty(w.FullName) ? w.Email : w.FullName)</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold small text-muted">Priority</label>
                <select name="priority" class="form-select" required>
                    <option value="low">Low</option>
                    <option value="medium" selected>Medium</option>
                    <option value="high">High</option>
                    <option value="urgent">Urgent</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold small text-muted">New Deadline</label>
                <input type="date" name="deadline" class="form-control" required value="@DateTime.UtcNow.AddDays(3).ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-danger w-100 fw-bold">Reassign Job</button>
            </div>
        </form>
    </div>
}

@if (isOverdue && !canReassign && !isWithdrawn)
{
    <div class="alert alert-danger d-flex justify-content-between align-items-center shadow-sm border-0 mb-4">
        <div>
            <h5 class="alert-heading fw-bold mb-1"><i class="fa-solid fa-triangle-exclamation me-2"></i>Complaint Overdue!</h5>
            <p class="mb-0">This complaint has passed its deadline (@Model.Deadline?.ToString("dd MMM yyyy HH:mm")) and requires immediate attention.</p>
        </div>
        <a href="mailto:@supervisorEmail?subject=@emailSubject&body=@emailBody" class="btn btn-danger btn-lg fw-bold px-4 py-2" style="white-space: nowrap;">
            <i class="fa-solid fa-envelope me-2"></i> Escalate to Supervisor
        </a>
    </div>
}

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between mb-3">
                    <h5 class="fw-bold mb-0">@Model.Title</h5>
                    @if (isOverdue)
                    {
                        <span class="badge bg-danger px-3 py-2 rounded-pill fs-6">Overdue</span>
                    }
                    else
                    {
                        <span class="badge bg-@(isRejected || isReopened ? "danger" : isWithdrawn ? "secondary" : "info text-dark") text-capitalize px-3 py-2 rounded-pill">@Model.Status.ToString().Replace("_", " ")</span>
                    }
                </div>
                <p class="text-muted">@Model.Description</p>

                <div class="row mt-4">
                    <div class="col-md-6 mb-3">
                        <div class="text-muted small fw-bold">Location</div>
                        <div>@Model.Residence?.Name, Room @Model.Location</div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="text-muted small fw-bold">Category</div>
                        <div>@Model.Category?.Name</div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="text-muted small fw-bold">Reported By</div>
                        <div>@(Model.Reporter?.FullName ?? "Unknown")</div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="text-muted small fw-bold">Date Reported</div>
                        <div>@Model.CreatedAt.ToString("dd MMMM yyyy, HH:mm")</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ONLY SHOW REPORTER PHOTOS TO ADMIN -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3"><i class="fa-solid fa-camera me-2"></i>Reporter Photos</h6>
                @if (adminVisibleImages.Any())
                {
                    <div class="d-flex gap-3 flex-wrap">
                        @foreach (var img in adminVisibleImages)
                        {
                            <div>
                                <a href="@img.ImageUrl" target="_blank">
                                    <img src="@img.ImageUrl" alt="Complaint Photo" style="width: 150px; height: 150px; object-fit: cover; border-radius: 8px; border: 1px solid #ccc;" />
                                </a>
                                <div class="text-muted small text-center mt-1">@img.UploadedAt.ToString("dd MMM, HH:mm")</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-muted small">No reporter photos attached.</div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm border-0 mb-4 bg-light">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3"><i class="fa-solid fa-user-gear me-2"></i>Currently Assigned To</h6>
                @if (assignedWorker != null)
                {
                    <div class="fw-bold">@(string.IsNullOrEmpty(assignedWorker.FullName) ? assignedWorker.Email : assignedWorker.FullName)</div>
                    <div class="text-muted small">@assignedWorker.Email</div>
                    <div class="mt-3">
                        <div class="text-muted small fw-bold">Deadline</div>
                        <div class="@(isOverdue ? "text-danger fw-bold" : "")">
                            @(Model.Deadline?.ToString("dd MMMM yyyy") ?? "Not set")
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-muted small">Not assigned yet.</div>
                }
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-4"><i class="fa-solid fa-clock-rotate-left me-2"></i>Status Timeline</h6>
                <div class="timeline">
                    @if (history != null && history.Any())
                    {
                        @foreach (var item in history)
                        {
                            <div class="d-flex mb-3">
                                <div class="me-3 mt-1">
                                    <i class="fa-solid fa-circle text-primary" style="font-size: 0.6rem;"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark small">@item.Action</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">
                                        @(item.User?.FullName ?? "System") - @item.CreatedAt.ToString("dd MMM, HH:mm")
                                    </div>
                                    @if (!string.IsNullOrEmpty(item.Comment))
                                    {
                                        <div class="mt-2 p-2 bg-white rounded border" style="font-size: 0.8rem; border-left: 3px solid #0057B8 !important;">
                                            <strong>HCM Feedback:</strong> "@item.Comment"
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-muted small">No history recorded yet.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>