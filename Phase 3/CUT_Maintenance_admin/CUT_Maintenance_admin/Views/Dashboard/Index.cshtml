@model IEnumerable<CUT_Maintenance_Admin.Models.Complaint>
@using CUT_Maintenance_Admin.Data
@{
    ViewData["Title"] = "Detailed Overview";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <h4 class="fw-bold mb-0">Detailed Overview</h4>
    <a asp-action="AllComplaints" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-arrow-left"></i> Back to All Complaints</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Stats Cards -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-title">Total Complaints</div>
            <div class="stat-value text-primary">@ViewBag.TotalComplaints</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-title">Active / Pending</div>
            <div class="stat-value text-warning">@ViewBag.ActiveComplaints</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-title">Overdue</div>
            <div class="stat-value text-danger">@ViewBag.OverdueComplaints</div>
        </div>
    </div>
</div>

<!-- Detailed Table -->
<div class="table-responsive table-custom">
    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th class="ps-3">Ref</th>
                <th>Photos</th>
                <th>Details</th>
                <th>Residence</th>
                <th>Reporter</th>
                <th>Priority</th>
                <th>Status</th>
                <th>Deadline</th>
                <th class="pe-3">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var item in Model)
                {
                    var isOverdue = item.Deadline < DateTime.UtcNow && item.Status != ComplaintStatus.closed && item.Status != ComplaintStatus.verified;
                    <tr class="align-middle">
                        <td class="ps-3 fw-bold">@item.Reference</td>

                        <!-- Multiple Photos Column -->
                        <td>
                            @if (item.Images != null && item.Images.Any())
                            {
                                <div style="display: flex; gap: 5px; flex-wrap: wrap;">
                                    @foreach (var img in item.Images)
                                    {
                                        <a href="@img.ImageUrl" target="_blank">
                                            <img src="@img.ImageUrl" alt="Complaint Photo" style="max-width: 60px; max-height: 60px; border-radius: 5px; object-fit: cover; border: 1px solid #ccc;" title="Uploaded: @img.UploadedAt.ToString("g")" />
                                        </a>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted small">No photos</span>
                            }
                        </td>

                        <!-- Title and Worker Notes -->
                        <td>
                            <div style="font-weight: bold;">@item.Title</div>
                            @if (!string.IsNullOrEmpty(item.CompletionNotes))
                            {
                                <div style="font-size: 12px; color: #555; margin-top: 4px; padding: 4px; background-color: #f8f9fa; border-left: 3px solid #1E7E34;">
                                    <strong>Worker Note:</strong> @item.CompletionNotes
                                </div>
                            }
                        </td>

                        <td>@(item.Residence?.Name ?? "N/A")</td>
                        <td>@(item.Reporter?.FullName ?? item.Reporter?.Email ?? "Unknown")</td>
                        <td>
                            <span class="badge bg-@(item.Priority == PriorityLevel.high ? "danger" : item.Priority == PriorityLevel.medium ? "warning text-dark" : "secondary")">
                                @item.Priority.ToString()
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-info text-dark text-capitalize">@item.Status.ToString().Replace("_", " ")</span>
                            @if (isOverdue)
                            {
                                <span class="badge bg-danger ms-1">OVERDUE</span>
                            }
                        </td>
                        <td>@(item.Deadline?.ToString("yyyy-MM-dd") ?? "Not set")</td>
                        <td class="pe-3">
                            @if (item.Status == ComplaintStatus.reported)
                            {
                                <a asp-action="Assign" asp-route-id="@item.Id" class="btn btn-sm btn-primary" style="background-color: #0084D6;">Assign</a>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-secondary" disabled>Assigned</button>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center py-5 text-muted">
                        <h5>No complaints found.</h5>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>